# Копирај го овој фајл во .env и пополни ги вредностите.
# .env НИКОГАШ не смее да оди во git репозиториум.

PORT=4000

# MySQL — истиот сервер каде што седи и WordPress/WooCommerce базата
DB_HOST=localhost
DB_PORT=3306
DB_USER=pianoforte_app
DB_PASSWORD=changeme
DB_NAME=pianoforte

# Долг случаен стринг, пр. генериран со: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Плаќање — пополнува се откако ќе имаш акаунт кај платежен процесор
# (CPay/NestPay за македонски банки, или Stripe меѓународно).
# Клучен принцип: серверот НИКОГАШ не прима суров број на картичка —
# само tokenized payment_method_id генериран на клиентска страна.
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
